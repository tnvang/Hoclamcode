local function GetColor(score)
    if score >= 80 then
        return Config.Colors.Red
    elseif score >= 50 then
        return Config.Colors.Orange
    elseif score >= Config.HackThreshold then
        return Config.Colors.Yellow
    end

    return Config.Colors.Green
end

