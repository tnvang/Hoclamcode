function Sim.Refresh()
    local player = Sim.Player

    if not Sim.Panel or not player then
        return
    end

    if player.Parent ~= Players then
        Sim.Close()
        return
    end

    if Sim.Stamp ~= Sim.StampOf(player) then
        Sim.Show(player)
    end
end

