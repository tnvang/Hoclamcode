function Spec.Begin(player)
    local character = player.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local camera = Workspace.CurrentCamera

    if not humanoid or not camera then
        UI.ProgressText.Text = "Không thể quan sát " .. player.Name .. " (chưa có nhân vật)."
        return false
    end

    local first = State.Spectating == nil

    if first then
        State.CameraSubject = camera.CameraSubject
        State.OldFov = camera.FieldOfView
        RunService:BindToRenderStep("CheatRevealSpectate", Enum.RenderPriority.Camera.Value + 1, Spec.Step)
    end

    Spec.Unhide()
    State.Spectating = player
    State.SpecMode = "first"

    local ui = Spec.GetCard()

    ui.Frame.Visible = true
    ui.View.Text = "GÓC: THỨ NHẤT"
    ui.Title.Text = "ĐANG XEM: " .. player.DisplayName .. " (@" .. player.Name .. ")"

    camera.CameraType = Enum.CameraType.Scriptable
    Spec.Apply()

    if first then
        UI.Main.Visible = false
    end

    UI.Floating.Visible = true
    UI.ProgressText.Text = "ĐANG QUAN SÁT: " .. player.Name .. ". Bấm nút ◉ để mở hoặc ẩn giao diện chính."

    if Sim.Panel then
        Safe(Sim.Show, player)
    end

    if UI.Details and UI.Details.Panel.Parent then
        Safe(ShowDetails, player)
    end

    return true
end

function Spec.Next(step)
    local list = {}

    for _, other in ipairs(Players:GetPlayers()) do
        if other ~= LocalPlayer then
            table.insert(list, other)
        end
    end

    if #list == 0 then
        StopSpectating()
        return
    end

    table.sort(list, function(a, b)
        return a.Name < b.Name
    end)

    local index = table.find(list, State.Spectating) or 0
    local count = #list

    for _ = 1, count do
        index = (index - 1 + step) % count + 1

        if Spec.Begin(list[index]) then
            return
        end
    end
end

function Spec.Update()
    local player = State.Spectating

    if not player then
        return
    end

    if player.Parent ~= Players then
        StopSpectating()
        return
    end

    Spec.Apply()

    local ui = Spec.Ui

    if not ui then
        return
    end

    local character = player.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    local data = ViewData(player)
    local speed = 0

    if root and root:IsA("BasePart") then
        local velocity = root.AssemblyLinearVelocity
        speed = Vector3.new(velocity.X, 0, velocity.Z).Magnitude
    end

    local verdict = data.Scanned and data.Status or "CHƯA QUÉT SÂU"
    local logCount = LogCount(BgView(player))

    if logCount > 0 then
        verdict = verdict .. "  |  Ngầm: " .. logCount .. " dấu hiệu"
    end

    ui.Info.Text = "Tốc độ ngang: " .. FormatNumber(speed) .. " studs/s  |  " .. verdict .. "  |  Điểm: " .. data.Score .. "%"

    local simOpen = Sim.Panel ~= nil and Sim.Player == player
    local details = UI.Details
    local detailOpen = details ~= nil and details.Player == player and details.Panel.Parent ~= nil

    ui.Sim.Text = simOpen and "ĐÓNG MÔ PHỎNG" or "MÔ PHỎNG"
    ui.Detail.Text = detailOpen and "ĐÓNG CHI TIẾT" or "CHI TIẾT"
    ui.Scan.Text = State.Scanning and ("QUÉT " .. math.floor(State.Progress) .. "%") or "TRA"
end

StopSpectating = function()
    local was = State.Spectating ~= nil

    State.Spectating = nil
    State.SpecMode = "first"

    if not was then
        return
    end

    pcall(function()
        RunService:UnbindFromRenderStep("CheatRevealSpectate")
    end)

    Spec.Unhide()

    pcall(function()
        LocalPlayer.ReplicationFocus = nil
    end)

    if Spec.Ui then
        Spec.Ui.Frame.Visible = false
    end

    local camera = Workspace.CurrentCamera

    if camera then
        local character = LocalPlayer.Character
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")

        camera.CameraType = Enum.CameraType.Custom
        camera.CameraSubject = humanoid or State.CameraSubject
        camera.FieldOfView = State.OldFov
    end

    if not State.Destroyed then
        UI.Floating.Visible = not UI.Main.Visible
    end
end

local function Spectate(player)
    if State.Spectating == player then
        StopSpectating()
        return
    end

    Spec.Begin(player)
end

