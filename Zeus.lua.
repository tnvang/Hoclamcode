local function UpdatePlayerRow(player)
    local ui = Rows[player]

    if not ui then
        return
    end

    local data = ViewData(player)
    local bg = BgView(player)
    local logged = LogList(bg)
    local score = data.Score
    local active = data.Scanned and score >= Config.HackThreshold
    local color = GetColor(score)
    local barScore = 0
    local barColor = Config.Colors.Green
    local barActive = false

    ui.Name.Text = player.DisplayName .. "  (@" .. player.Name .. ")"
    ui.Status.Text = data.Status

    if data.Scanning then
        ui.Status.TextColor3 = Config.Colors.Yellow
        ui.Percent.Text = "..."
        ui.Percent.TextColor3 = Config.Colors.Accent
        ui.Tags.Text = "Đang quét sâu, kết luận sau khi quét xong..."
        ui.Tags.TextColor3 = Config.Colors.Gray
    elseif data.Scanned then
        barScore = score
        barColor = color
        barActive = active

        ui.Status.TextColor3 = active and color or Config.Colors.Gray
        ui.Percent.Text = score .. "%"
        ui.Percent.TextColor3 = color

        if active then
            ui.Tags.Text = "Phát hiện " .. math.max(1, #data.Known + data.Unknown) .. " chức năng hack. Bấm MÔ PHỎNG để xem bảng của " .. player.Name
            ui.Tags.TextColor3 = Config.Colors.Red
        elseif #logged > 0 then
            ui.Tags.Text = "Quét ngầm từng ghi nhận: " .. table.concat(logged, "  •  ")
            ui.Tags.TextColor3 = Config.Colors.Orange
        elseif (data.Moved or 0) < Config.MinMoved then
            ui.Tags.Text = "Người này chưa chạy đủ lâu trong lúc quét. Hãy quét lại khi họ đang di chuyển."
            ui.Tags.TextColor3 = Config.Colors.Yellow
        else
            ui.Tags.Text = "Không phát hiện phần mềm hack"
            ui.Tags.TextColor3 = Config.Colors.Gray
        end
    elseif #logged > 0 then
        barScore = bg.Peak
        barColor = GetColor(bg.Peak)
        barActive = true

        ui.Status.Text = "PHÁT HIỆN NGẦM"
        ui.Status.TextColor3 = barColor
        ui.Percent.Text = bg.Peak .. "%"
        ui.Percent.TextColor3 = barColor
        ui.Tags.Text = "Ngầm: " .. table.concat(logged, "  •  ")
        ui.Tags.TextColor3 = Config.Colors.Red
    else
        ui.Status.Text = State.Bg and "ĐANG GIÁM SÁT NGẦM" or "CHƯA QUÉT"
        ui.Status.TextColor3 = Config.Colors.Gray
        ui.Percent.Text = "--"
        ui.Percent.TextColor3 = Config.Colors.Gray
        ui.Tags.Text = State.Bg and "Quét ngầm đang theo dõi. Bấm TRA để quét sâu người này." or "Chưa quét. Bấm TRA để kiểm tra người này."
        ui.Tags.TextColor3 = Config.Colors.Gray
    end

    if ui.LastScore ~= barScore or ui.LastActive ~= barActive then
        ui.LastScore = barScore
        ui.LastActive = barActive

        TweenService:Create(ui.Fill, TweenInfo.new(0.25), {
            Size = UDim2.new(barScore / 100, 0, 1, 0),
            BackgroundColor3 = barColor
        }):Play()

        if ui.Stroke then
            ui.Stroke.Color = barActive and barColor or Color3.fromRGB(255, 255, 255)
            ui.Stroke.Transparency = barActive and 0.35 or 0.84
        end
    end
