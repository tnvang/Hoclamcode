local function Trim(list, now, life)
    while #list > 0 and now - list[1] > life do
        table.remove(list, 1)
    end
end

local function Recompute(data)
    local now = os.clock()
    local total = 0
    local groups = 0
    local list = {}
    local known = {}
    local seen = {}
    local unknown = 0

    for id, evidence in pairs(data.Evidence) do
        if data.IsBg and now - evidence.Time > Config.BgLife then
            data.Evidence[id] = nil
        else
            local confirmed = evidence.Count >= evidence.Need

            table.insert(list, {
                Id = id,
                Name = evidence.Name,
                Known = evidence.Known,
                Text = evidence.Detail,
                Count = evidence.Count,
                Need = evidence.Need,
                Weight = evidence.Weight,
                Confirmed = confirmed
            })

            if confirmed then
                total += evidence.Weight
                groups += 1

                if evidence.Known then
                    if not seen[evidence.Name] and evidence.Weight >= 18 then
                        seen[evidence.Name] = true
                        table.insert(known, evidence.Name)
                    end
                elseif evidence.Weight >= 18 then
                    unknown += 1
                end
            end
        end
    end

    if groups > 1 then
        total += math.min((groups - 1) * 6, 18)
    end

    data.Score = math.clamp(math.floor(total + 0.5), 0, 100)
    data.Peak = math.max(data.Peak or 0, data.Score)

    table.sort(known)
    data.Known = known
    data.Unknown = unknown

    if data.Scanning then
        data.Status = "ĐANG TRA..."
    elseif not data.Scanned then
        data.Status = "CHƯA QUÉT"
    elseif data.Score >= Config.HackThreshold then
        data.Status = "CÓ SỬ DỤNG HACK"
    elseif data.Score > 0 then
        data.Status = "DẤU HIỆU NHẸ - CHƯA KẾT LUẬN"
    elseif (data.Moved or 0) < Config.MinMoved then
        data.Status = "CHƯA ĐỦ DỮ LIỆU - QUÉT LẠI"
    else
        data.Status = "BÌNH THƯỜNG"
    end

    table.sort(list, function(a, b)
        if a.Confirmed ~= b.Confirmed then
            return a.Confirmed
        end

        if a.Weight ~= b.Weight then
            return a.Weight > b.Weight
        end

        return a.Id < b.Id
    end)

    while #list > Config.MaxDetails do
        table.remove(list)
    end

    data.Details = list
end

local function HackSummary(data)
    local parts = {}

    for _, name in ipairs(data.Known) do
        table.insert(parts, name)
    end

    if data.Unknown > 0 then
        table.insert(parts, "Sử dụng " .. data.Unknown .. " loại hack không xác định")
    end

    if #parts == 0 then
        return "Hack không xác định"
    end

    return table.concat(parts, "  •  ")
end

local function LogList(data)
    local names = {}
    local unknown = 0

    for _, entry in pairs(data.Log) do
        if entry.Known then
            table.insert(names, entry.Name)
        else
            unknown += 1
        end
    end

    table.sort(names)

    if unknown > 0 then
        table.insert(names, "Sử dụng " .. unknown .. " loại hack không xác định")
    end

    return names
end

local function LogCount(data)
    local count = 0

    for _ in pairs(data.Log) do
        count += 1
    end

    return count
end

local function AddEvidence(player, id, weight, need, detail, amount)
    local data = GetData(player)
    local add = amount or 1
    local now = os.clock()
    local evidence = data.Evidence[id]

    if data.IsBg then
        need = math.ceil(need * Config.BgNeedMul)

        if evidence and now - evidence.Time > Config.BgLife then
            data.Evidence[id] = nil
            evidence = nil
        end
    end

    if evidence then
        evidence.Count += add
        evidence.Detail = detail
        evidence.Weight = weight
        evidence.Need = need
        evidence.Time = now
    else
        local name = KnownHacks[string.match(id, "^%u+")]

        data.Evidence[id] = {
            Name = name or "Hack không xác định",
            Known = name ~= nil,
            Weight = weight,
            Need = need,
            Count = add,
            Time = now,
            Detail = detail
        }
    end

    data.Dirty = true
end

local function BgCommit(player)
    local data = BgView(player)

    Recompute(data)

    if data.Score < Config.HackThreshold then
        return
    end

    local now = os.time()

    for _, evidence in ipairs(data.Details) do
        if evidence.Confirmed and evidence.Weight >= 18 then
            local key = evidence.Known and evidence.Name or evidence.Id
            local entry = data.Log[key]

            if not entry then
                entry = {
                    Name = evidence.Known and evidence.Name or "Hack không xác định",
                    Key = string.match(evidence.Id, "^%u+"),
                    Known = evidence.Known,
                    First = now
                }

                data.Log[key] = entry
                table.insert(State.Alerts, {Player = player, Name = entry.Name})
            end

            entry.Last = now
            entry.Text = evidence.Text
            entry.Count = evidence.Count
            entry.Need = evidence.Need
        end
    end
end

local function Ctx(callback, ...)
    if State.Destroyed then
        return
    end

    if State.BgActive or State.Scanning then
        Safe(callback, ...)
        return
    end

    if not State.Bg then
        return
    end

    State.BgActive = true
    Safe(callback, ...)
    State.BgActive = false
end

local function GetParts(player)
    local character = player.Character

    if not character or not character.Parent then
        return nil
    end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local root = character:FindFirstChild("HumanoidRootPart")

    if not humanoid or not root or not root:IsA("BasePart") then
        return nil
    end

    return character, humanoid, root
end

