function Heal.Burst(player, st, amount, fromFrac, toFrac, now)
    local data = GetData(player)
    local seen = st.ToolSeen
    local viaTool = seen ~= nil and now - seen.Time <= Config.HealToolLink
    local gap = nil

    if st.EquipTime and now - st.EquipTime <= Config.HealToolLink then
        gap = now - st.EquipTime
    end

    table.insert(data.HealTimes, now)
    Trim(data.HealTimes, now, Config.BgLife)

    table.insert(st.Events, {Time = now, Amount = amount, From = fromFrac, To = toFrac})

    while #st.Events > 12 do
        table.remove(st.Events, 1)
    end

    local summary = "+" .. FormatNumber(amount) .. " máu (từ " .. Heal.Pct(fromFrac) .. " lên " .. Heal.Pct(toFrac) .. ")"
    local recent = 0

    for _, event in ipairs(st.Events) do
        if now - event.Time <= Config.HealWindow then
            recent += 1
        end
    end

    if recent >= Config.HealRapid then
        AddEvidence(
            player,
            "AUTOHEAL_RAPID",
            45,
            2,
            "Hồi máu " .. recent .. " lần trong " .. Config.HealWindow .. "s, lần gần nhất " .. summary
                .. "; mỗi lần hồi ít nhất " .. Heal.Pct(Config.HealMinFrac) .. " máu tối đa trong chưa tới "
                .. FormatNumber(Config.HealSeries) .. "s (hồi máu tự nhiên chỉ khoảng 1%/giây, và game chỉ cho lấy ra 1 cuộn mỗi lần)"
        )
    end

    local mids = {}

    for index = math.max(1, #st.Events - 5), #st.Events do
        local event = st.Events[index]

        if event.From >= Config.HealMidMin and event.From <= Config.HealMidMax
            and now - event.Time <= Config.HealThreshWindow then
            table.insert(mids, event)
        end
    end

    if #mids >= 3 then
        local low = math.huge
        local high = -math.huge

        for _, event in ipairs(mids) do
            low = math.min(low, event.From)
            high = math.max(high, event.From)
        end

        if high - low <= Config.HealBand then
            AddEvidence(
                player,
                "AUTOHEAL_THRESH",
                45,
                2,
                "Hồi máu " .. #mids .. " lần liên tiếp đúng ở mức máu " .. Heal.Pct(low) .. " đến " .. Heal.Pct(high)
                    .. " (chênh chỉ " .. Heal.Pct(high - low) .. "); người thật hồi ở các mức máu khác nhau, script auto heal thì hồi khi máu chạm một ngưỡng cố định"
            )
        end
    end

    if #st.Events >= 5 then
        local low = math.huge
        local high = -math.huge
        local sum = 0

        for index = #st.Events - 3, #st.Events do
            local distance = st.Events[index].Time - st.Events[index - 1].Time

            low = math.min(low, distance)
            high = math.max(high, distance)
            sum += distance
        end

        local mean = sum / 4

        if high - low <= Config.HealTiming and mean <= Config.HealWindow then
            AddEvidence(
                player,
                "AUTOHEAL_TIMING",
                38,
                2,
                "5 lần hồi máu liên tiếp cách nhau đều đặn " .. FormatNumber(low) .. "s đến " .. FormatNumber(high)
                    .. "s (trung bình " .. FormatNumber(mean) .. "s), lệch chưa tới " .. FormatNumber(Config.HealTiming) .. "s; người thật không bấm đều như máy"
            )
        end
    end

    if viaTool and gap and gap <= Config.HealEquipGap then
        table.insert(st.FastTimes, now)
        Trim(st.FastTimes, now, Config.BgLife)

        AddEvidence(
            player,
            "AUTOHEAL_TOOL",
            40,
            4,
            "Lấy cuộn hồi máu ra rồi hồi máu chỉ sau " .. FormatNumber(gap * 1000) .. "ms (người thật cần khoảng 0.4s trở lên để lấy cuộn rồi bấm dùng); đã lặp lại "
                .. #st.FastTimes .. " lần, lần gần nhất " .. summary
        )
    end

    if not viaTool then
        table.insert(st.NoToolTimes, now)
        Trim(st.NoToolTimes, now, Config.BgLife)

        if #st.NoToolTimes >= 3 then
            AddEvidence(
                player,
                "AUTOHEAL_NOTOOL",
                10,
                3,
                "Hồi máu " .. #st.NoToolTimes .. " lần mà không thấy cầm vật phẩm hồi máu nào trên tay (dấu hiệu phụ, có thể do cơ chế game)"
            )
        end
    end
end

function Heal.OnHealth(player, humanoid, health)
    if State.Destroyed or not Heal.Active then
        return
    end

    local st = Heal.Get(player)
    local now = os.clock()
    local previous = st.Last
    local max = math.max(humanoid.MaxHealth, 1)

    st.Last = health

    if st.Max ~= max then
        st.Max = max
        st.Series = 0
        return
    end

    if previous == nil or previous <= 0 or health <= 0 then
        st.Series = 0
        return
    end

    if health <= previous then
        return
    end

    if now - st.SeriesStart > Config.HealSeries then
        st.SeriesStart = now
        st.Series = 0
        st.SeriesFrom = previous
        st.Counted = false
    end

    st.Series += health - previous

    if not st.Counted and st.Series >= max * Config.HealMinFrac and st.Series >= Config.HealMinAbs then
        st.Counted = true
        Heal.Burst(player, st, st.Series, st.SeriesFrom / max, health / max, now)
    end
end

function Heal.OnTool(player, character, tool, added)
    if State.Destroyed or not Heal.Active or not Heal.IsTool(tool) then
        return
    end

    local st = Heal.Get(player)
    local now = os.clock()

    st.ToolSeen = {Time = now, Name = tool.Name}

    if not added then
        return
    end

    st.EquipTime = now
    table.insert(st.Equips, now)
    Trim(st.Equips, now, Config.HealToolWindow)

    local held = 0

    for _, child in ipairs(character:GetChildren()) do
        if child:IsA("Tool") and Heal.IsTool(child) then
            held += 1
        end
    end

    if held >= 2 then
        AddEvidence(
            player,
            "AUTOHEAL_MULTI",
            40,
            2,
            "Đang cầm cùng lúc " .. held .. " cuộn/vật phẩm hồi máu, trong khi game chỉ cho lấy ra 1 cuộn mỗi lần"
        )
    end

    if #st.Equips >= Config.HealToolSwitches then
        AddEvidence(
            player,
            "AUTOHEAL_CYCLE",
            45,
            2,
            "Lấy vật phẩm hồi máu ra khỏi balo " .. #st.Equips .. " lần trong " .. Config.HealToolWindow
                .. "s (liên tục lấy cuộn khác ra để hồi, người thật chỉ lấy 1 cuộn rồi chờ)"
        )
    end
end

function Heal.Hook(player, character)
    local session = Heal.Session

    task.spawn(function()
        local humanoid = character:FindFirstChildOfClass("Humanoid") or character:WaitForChild("Humanoid", 5)

        if not humanoid or State.Destroyed or not Heal.Active or session ~= Heal.Session then
            return
        end

        local old = Heal.Chars[player]

        if old then
            for _, connection in ipairs(old) do
                connection:Disconnect()
            end
        end

        local st = Heal.Get(player)

        st.Last = humanoid.Health
        st.Max = math.max(humanoid.MaxHealth, 1)
        st.Series = 0

        Heal.Chars[player] = {
            humanoid.HealthChanged:Connect(function(health)
                Ctx(Heal.OnHealth, player, humanoid, health)
            end),
            character.ChildAdded:Connect(function(child)
                if child:IsA("Tool") then
                    Ctx(Heal.OnTool, player, character, child, true)
                end
            end),
            character.ChildRemoved:Connect(function(child)
                if child:IsA("Tool") then
                    Ctx(Heal.OnTool, player, character, child, false)
                end
            end)
        }
    end)
end

function Heal.Attach(player)
    if player == LocalPlayer then
        return
    end

    Heal.Add(player.CharacterAdded:Connect(function(character)
        Heal.Hook(player, character)
    end))

    if player.Character then
        Heal.Hook(player, player.Character)
    end
end

function Heal.Stop()
    Heal.Active = false

    for _, connection in ipairs(Heal.Conns) do
        connection:Disconnect()
    end

    table.clear(Heal.Conns)

    for player, list in pairs(Heal.Chars) do
        for _, connection in ipairs(list) do
            connection:Disconnect()
        end

        Heal.Chars[player] = nil
    end
end

function Heal.Start()
    if Heal.Active then
        return
    end

    Heal.Session += 1
    Heal.Active = true
    Heal.Reset()

    for _, player in ipairs(Players:GetPlayers()) do
        Heal.Attach(player)
    end

    Heal.Add(Players.PlayerAdded:Connect(function(player)
        Heal.Attach(player)
    end))
end

local function RootOf(humanoid)
    local model = humanoid.Parent

    if not model then
        return nil
    end

    local part = model:FindFirstChild("HumanoidRootPart")

    if part and part:IsA("BasePart") then
        return part
    end

    if model:IsA("Model") and model.PrimaryPart then
        return model.PrimaryPart
    end

    return model:FindFirstChildWhichIsA("BasePart")
end

local function ResetRing()
    for index = 1, RingSize do
        DamageRing[index] = nil
    end

    State.DamageCount = 0
    State.DamageDirty = false
end

local function TrackHumanoid(humanoid)
    if not State.Tracking or Tracked[humanoid] ~= nil or not humanoid.Parent then
        return
    end

    local record = {Health = humanoid.Health, Conns = {}}
    Tracked[humanoid] = record

    record.Conns[1] = humanoid.HealthChanged:Connect(function(health)
        if State.Destroyed or not State.Tracking then
            return
        end

        local previous = record.Health
        record.Health = health

        if previous and health < previous then
            local part = RootOf(humanoid)

            if part then
                State.DamageCount += 1
                DamageRing[State.DamageCount % RingSize + 1] = {
                    Time = os.clock(),
                    Humanoid = humanoid,
                    Position = part.Position,
                    Delta = previous - health,
                    Dead = health <= 0,
                    Nearest = nil,
                    Distance = 0,
                    Clear = false,
                    IsPlayer = false,
                    Counted = false,
                    Checked = false
                }
                State.DamageDirty = true
            end
        end
    end)

    record.Conns[2] = humanoid.AncestryChanged:Connect(function(_, parent)
        if not parent then
            for _, connection in ipairs(record.Conns) do
                connection:Disconnect()
            end

            if Tracked[humanoid] == record then
                Tracked[humanoid] = nil
            end
        end
    end)
end

local function StartCombat()
    ResetRing()

    if State.Tracking then
        return
    end

    State.Tracking = true

    task.spawn(function()
        local count = 0

        for _, instance in ipairs(Workspace:GetDescendants()) do
            if State.Destroyed or not State.Tracking then
                return
            end

            count += 1

            if count % 500 == 0 then
                task.wait()
            end

            if instance:IsA("Humanoid") then
                TrackHumanoid(instance)
            end
        end
    end)

    State.CombatMain = Workspace.DescendantAdded:Connect(function(instance)
        if instance:IsA("Humanoid") then
            task.defer(TrackHumanoid, instance)
        end
    end)

    Safe(Heal.Start)
end

local function StopCombat()
    State.Tracking = false

    if State.CombatMain then
        State.CombatMain:Disconnect()
        State.CombatMain = nil
    end

    for humanoid, record in pairs(Tracked) do
        for _, connection in ipairs(record.Conns) do
            connection:Disconnect()
        end

        Tracked[humanoid] = nil
    end

    Safe(Heal.Stop)
end

