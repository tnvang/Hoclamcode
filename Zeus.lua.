    local on = 0

    for _, record in ipairs(ui.Rows) do
        if record.On then
            on += 1
        end
    end

    ui.OnLabel.Text = "ĐANG BẬT (" .. on .. ")"
    ui.OffLabel.Text = "ĐANG TẮT (" .. (#ui.Rows - on) .. ")"
end

