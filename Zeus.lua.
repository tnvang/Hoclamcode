local function Notify(text, color)
    if State.Destroyed then
        return
    end

    local toast = UI.Toast

    if not toast then
        local frame = Create("Frame", {
            Name = "Toast",
            AnchorPoint = Vector2.new(0.5, 0),
            Size = UDim2.fromOffset(320, 30),
            Position = UDim2.new(0.5, 0, 0, -50),
            BackgroundColor3 = Config.Colors.Black,
            BackgroundTransparency = 0.1,
            BorderSizePixel = 0,
            Visible = false,
            ZIndex = 90
        }, UI.Gui)

        Corner(frame, 10)

        local stroke = Stroke(frame, Config.Colors.Red, 0.2, 1.5)

        local label = Create("TextLabel", {
            Size = UDim2.new(1, -16, 1, 0),
            Position = UDim2.fromOffset(8, 0),
            BackgroundTransparency = 1,
            Text = "",
            TextColor3 = Config.Colors.White,
            TextSize = 11,
            Font = Enum.Font.GothamBold,
            TextTruncate = Enum.TextTruncate.AtEnd,
            ZIndex = 91
        }, frame)

        toast = {Frame = frame, Label = label, Stroke = stroke, Token = 0}
        UI.Toast = toast
    end

    toast.Token += 1

    local token = toast.Token

    toast.Label.Text = text
    toast.Label.TextColor3 = color
    toast.Stroke.Color = color
    toast.Frame.Visible = true
    toast.Frame.Position = UDim2.new(0.5, 0, 0, -50)

    TweenService:Create(
        toast.Frame,
        TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
        {Position = UDim2.new(0.5, 0, 0, 8)}
    ):Play()

    UI.FloatStroke.Color = color

    task.delay(4, function()
        if State.Destroyed or toast.Token ~= token then
            return
        end

        TweenService:Create(
            toast.Frame,
            TweenInfo.new(0.25),
            {Position = UDim2.new(0.5, 0, 0, -50)}
        ):Play()

        UI.FloatStroke.Color = Config.Colors.Accent

        task.delay(0.3, function()
            if not State.Destroyed and toast.Token == token and toast.Frame.Parent then
                toast.Frame.Visible = false
            end
        end)
    end)
end

